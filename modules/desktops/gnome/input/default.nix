{
  # Settings -> Mouse & Touchpad
  dconf.settings = {
    # Touchpad
    "org/gnome/desktop/peripherals/touchpad" = {
      # Tap to Click
      #tap-to-click = true;

      # Scroll Method
      #two-finger-scrolling-enabled = true;

      # Scroll Direction
      #natural-scroll = true;
    };
  };
}
