{
  # Settings -> Keyboard -> Keyboard Shortcuts -> Screenshots
  dconf.settings = {
    "org/gnome/shell/keybindings" = {
      #show-screen-recording-ui = [ "<Ctrl><Shift><Alt>R" ];
      screenshot = [
        #"<Shift>Print"
        "Print"
      ];
      show-screenshot-ui = [
        #"Print"
        "<Shift>Print"
      ];
      #screenshot-window = [ "<Alt>Print" ];
    };
  };
}
