{
  # Configure Appearance...
  appearance = {
    #alwaysShowClock = true; # Show clock
    #showMediaControls = true; # Media controls

    # Wallpaper type -> Image
    #wallpaper = null;

    # Wallpaper type -> Picture of the Day
    wallpaperPictureOfTheDay = {
      provider = "apod"; # null, “apod”, “bing”, “flickr”, “natgeo”, “noaa”, “wcpotd”, “epod”, “simonstalenhag”
      #updateOverMeteredConnection = false;
    };

    # Wallpaper type -> Plain Color
    #wallpaperPlainColor = null;

    # Wallpaper type -> Slideshow
    #wallpaperSlideShow = null;
  };

  #autoLock = true;
  #timeout = 5; # Minutes
  #lockOnResume = true;

  #passwordRequired = true;
  #passwordRequiredDelay = 5; # Seconds
}
